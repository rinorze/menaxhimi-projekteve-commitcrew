# Copy this file to .env (never commit .env).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty = a local SQLite file (db.sqlite3), so everyone can start without a database.
# PostgreSQL (Krenare sets it up), e.g.:
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/discover_kosovo
DATABASE_URL=
